# Workiva / Wdesk — credenciales OAuth2 (Client Credentials Grant)
# Renombra este archivo a ".env" y rellena los valores antes de ejecutar setup_mcp.py
#
# Cómo obtenerlos:
#   1. Entra a Workiva → Administration → API Clients
#   2. Crea un cliente con grant type "Client Credentials"
#   3. Copia el Client ID y Client Secret
#   4. El Workspace ID está en la URL de Workiva: /workspace/{WORKSPACE_ID}/

WORKIVA_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WORKIVA_CLIENT_SECRET=wk_secret:oa2c:xxxxxxxxxxxxxxxxxxxxxxxx
WORKIVA_WORKSPACE_ID=w_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
